"""Integration tests: adapters against recorded responses, API end to end."""

import runpy

import pytest


def test_module_is_executable(capsys: pytest.CaptureFixture[str]) -> None:
    # `python -m {{package}}` ends with `raise SystemExit(main())`: exit code 0 is the success.
    with pytest.raises(SystemExit) as exc:
        runpy.run_module("{{package}}", run_name="__main__")
    assert exc.value.code == 0
    assert "{{package}}" in capsys.readouterr().out

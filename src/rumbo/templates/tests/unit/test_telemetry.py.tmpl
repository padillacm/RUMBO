"""Spans are logged as structured records with OTel GenAI attribute names.

The request id lives in a context variable (ADR-0012): nested spans share it, concurrent
tasks each get their own, an explicit id wins and is restored when its span closes.
"""

import asyncio
import json
import logging

import pytest

from {{package}}.app.budget import Meter
from {{package}}.app.telemetry import (
    LOGGER_NAME,
    JsonFormatter,
    configure_json_logging,
    current_request_id,
    span,
)


def test_span_logs_attributes_cost_and_status(caplog: pytest.LogCaptureFixture) -> None:
    meter = Meter()
    with (
        caplog.at_level(logging.INFO, logger=LOGGER_NAME),
        span("answer", model="test-model", request_id="r1", meter=meter) as current,
    ):
        meter.charge(input_tokens=10, output_tokens=5, cost_usd=0.002)
        current.set(**{"gen_ai.tool.name": "query"})
    record = caplog.records[-1]
    attrs = record.__dict__["span"]
    assert attrs["gen_ai.operation.name"] == "answer"
    assert attrs["gen_ai.request.model"] == "test-model"
    assert attrs["request.id"] == "r1"
    assert attrs["gen_ai.usage.input_tokens"] == 10
    assert attrs["cost.usd"] == 0.002
    assert attrs["gen_ai.tool.name"] == "query"
    assert attrs["status"] == "ok" and attrs["duration.ms"] >= 0
    line = json.loads(JsonFormatter().format(record))
    assert line["message"] == "answer" and line["gen_ai.operation.name"] == "answer"
    assert line["ts"].endswith("+00:00")


def test_configure_json_logging_is_idempotent() -> None:
    root = logging.getLogger()
    before = list(root.handlers)
    try:
        configure_json_logging()
        configure_json_logging()
        json_handlers = [h for h in root.handlers if isinstance(h.formatter, JsonFormatter)]
        assert len(json_handlers) == 1
    finally:
        root.handlers[:] = before


def test_span_records_errors_and_reraises(caplog: pytest.LogCaptureFixture) -> None:
    with (
        caplog.at_level(logging.INFO, logger=LOGGER_NAME),
        pytest.raises(ValueError),
        span("answer"),
    ):
        raise ValueError("boom")
    record = caplog.records[-1]
    attrs = record.__dict__["span"]
    assert record.levelno == logging.WARNING
    assert attrs["status"] == "error" and attrs["error.type"] == "ValueError"
    assert len(attrs["request.id"]) == 32  # generated when the caller has none


def test_nested_spans_share_the_request_id() -> None:
    assert current_request_id() is None
    with span("answer") as outer, span("model_call") as inner:
        assert inner.attributes["request.id"] == outer.attributes["request.id"]
        assert current_request_id() == outer.attributes["request.id"]
    assert current_request_id() is None  # the outermost span started the request and ends it


def test_concurrent_tasks_get_their_own_request_id() -> None:
    async def one_request() -> str:
        with span("answer"):
            await asyncio.sleep(0)  # both spans are open at the same time
            inner = current_request_id()
            assert inner is not None
            return inner

    async def two_requests() -> tuple[str, str]:
        return await asyncio.gather(one_request(), one_request())

    first, second = asyncio.run(two_requests())
    assert first != second


def test_an_explicit_request_id_wins_and_is_restored() -> None:
    with span("answer") as outer:
        with span("replay", request_id="given") as inner:
            assert inner.attributes["request.id"] == "given"
            assert current_request_id() == "given"
        assert current_request_id() == outer.attributes["request.id"]

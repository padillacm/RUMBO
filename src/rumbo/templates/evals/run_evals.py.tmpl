"""RUMBO eval runner (RUMBO.md, Part A, step A7 "Evals skeleton").

Reads JSONL cases ({"id", "input", "expected", "grader", "tags"}) from
evals/datasets/<suite>.jsonl, runs the real system k times per case, applies deterministic
graders and reports pass@1 and pass^k. Exits non-zero when pass^k < --min-pass.

Offline by default: the entry point must answer from recorded fixtures.{{#llm}} `--live` sets
RUMBO_EVALS_LIVE=1 so adapters may call the real model (use `make evals-live`).{{/llm}}

The entry may be a coroutine function (awaited) or a plain function (run in a worker thread);
`--concurrency N` bounds how many entry calls are in flight (ADR-0012). The report keeps the
case order whatever the concurrency, and with the default N=1 it is identical to a serial run.

Every report carries a fingerprint (ADR-0016): sha256 digests of the prompts under
src/{{package}}/prompts/, of evals/graders/judge.py and of the --entry reference. A `--live`
run records them in evals/fingerprint.json (commit it with the fixtures it describes); an
offline run that finds the file prints one warning per changed part after the summary line:
the prompts changed (the recorded fixtures may be stale: re-record with --live) or the judge
changed (re-calibrate, see evals/calibration/). The exit code is not affected by the warnings.

    uv run python evals/run_evals.py --suite smoke
    uv run python evals/run_evals.py --suite all --live --k 3 --min-pass 0.9 --concurrency 4
"""

from __future__ import annotations

import argparse
import asyncio
import hashlib
import importlib
import inspect
import json
import os
import sys
import time
from collections.abc import Callable
from datetime import date
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent))
from graders import GRADERS

DATASETS = Path(__file__).resolve().parent / "datasets"
REPORTS = Path(__file__).resolve().parent / "reports"
ROOT = Path(__file__).resolve().parents[1]
FINGERPRINT = Path(__file__).resolve().parent / "fingerprint.json"

Entry = Callable[[Any], Any]


def load_cases(suite: str) -> list[dict[str, Any]]:
    files = sorted(DATASETS.glob("*.jsonl")) if suite == "all" else [DATASETS / f"{suite}.jsonl"]
    cases: list[dict[str, Any]] = []
    for file in files:
        for n, line in enumerate(file.read_text(encoding="utf-8").splitlines(), 1):
            if not line.strip():
                continue
            case = json.loads(line)
            missing = {"id", "input", "expected", "grader"} - case.keys()
            if missing:
                raise ValueError(f"{file.name}:{n}: missing fields {sorted(missing)}")
            if case["grader"] not in GRADERS:
                raise ValueError(f"{file.name}:{n}: unknown grader {case['grader']!r}")
            cases.append(case)
    ids = [c["id"] for c in cases]
    if len(ids) != len(set(ids)):
        raise ValueError("duplicate case ids")
    return cases


def _sha256(*parts: bytes) -> str:
    digest = hashlib.sha256()
    for part in parts:
        digest.update(part)
    return digest.hexdigest()


def _normalized(file: Path) -> bytes:
    """File content with CRLF folded to LF, so a checkout on any platform hashes the same."""
    return file.read_bytes().replace(b"\r\n", b"\n")


def fingerprint(root: Path, entry: str) -> dict[str, str]:
    """sha256 digests of what a recorded fixture or a calibration depends on (ADR-0016)."""
    prompts = root / "src" / "{{package}}" / "prompts"
    files = sorted(
        (f.relative_to(prompts).as_posix(), f)
        for f in prompts.rglob("*")
        if f.is_file() and "__pycache__" not in f.parts
    )
    parts: list[bytes] = []
    for name, file in files:
        parts += [name.encode(), b"\x00", _normalized(file), b"\x00"]
    judge = root / "evals" / "graders" / "judge.py"
    return {
        "prompts": _sha256(*parts),
        "judge": _sha256(_normalized(judge) if judge.is_file() else b""),
        "entry": _sha256(entry.encode()),
    }


def drift_warnings(current: dict[str, str]) -> list[str]:
    """One warning per part that changed since the last live run; none without the record."""
    try:
        recorded = json.loads(FINGERPRINT.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    when = recorded.get("recorded", "unknown date")
    warnings: list[str] = []
    if recorded.get("prompts") != current["prompts"]:
        warnings.append(
            f"WARNING: prompts changed since the last live run ({when}): "
            "the recorded fixtures may be stale; re-record with --live"
        )
    if recorded.get("judge") != current["judge"]:
        warnings.append(
            f"WARNING: the judge changed since the last live run ({when}): "
            "re-calibrate before trusting its verdicts (see evals/calibration/)"
        )
    return warnings


def load_entry(ref: str) -> Entry:
    module, _, function = ref.partition(":")
    return getattr(importlib.import_module(module), function)


async def call_entry(entry: Entry, payload: Any) -> Any:
    """Awaits a coroutine entry; runs a synchronous one in a thread so the loop stays free."""
    if inspect.iscoroutinefunction(entry):
        return await entry(payload)
    result = await asyncio.to_thread(entry, payload)
    return await result if inspect.isawaitable(result) else result


async def run_case(
    entry: Entry, case: dict[str, Any], k: int, slot: asyncio.Semaphore
) -> dict[str, Any]:
    runs: list[dict[str, Any]] = []
    for _ in range(k):
        async with slot:
            start = time.perf_counter()
            try:
                output = await call_entry(entry, case["input"])
                verdict = GRADERS[case["grader"]](output, case["expected"])  # grading is sync
                ok, detail = verdict.ok, verdict.detail
            except Exception as exc:  # a case that blows up is a failed case
                ok, detail = False, f"exception: {exc!r}"
            runs.append({"ok": ok, "detail": detail, "seconds": time.perf_counter() - start})
    successes = sum(r["ok"] for r in runs)
    return {
        "id": case["id"],
        "tags": case.get("tags", []),
        "runs": runs,
        "passes_all": successes == k,
    }


def print_row(row: dict[str, Any], k: int) -> None:
    successes = sum(r["ok"] for r in row["runs"])
    mark = "PASS" if row["passes_all"] else "FAIL"
    detail = next((r["detail"] for r in row["runs"] if not r["ok"]), "")
    print(f"{mark} {row['id']} ({successes}/{k}) {detail}")


async def run_all(
    entry: Entry, cases: list[dict[str, Any]], k: int, concurrency: int
) -> list[dict[str, Any]]:
    """Runs every case with at most `concurrency` entry calls in flight; rows in case order."""
    slot = asyncio.Semaphore(concurrency)
    rows: list[dict[str, Any] | None] = [None] * len(cases)
    printed = 0

    async def one(index: int, case: dict[str, Any]) -> None:
        nonlocal printed
        rows[index] = await run_case(entry, case, k, slot)
        # Print in case order as soon as the next case in line is done (no reordering).
        while printed < len(rows) and (row := rows[printed]) is not None:
            print_row(row, k)
            printed += 1

    await asyncio.gather(*(one(i, case) for i, case in enumerate(cases)))
    return [row for row in rows if row is not None]


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Run deterministic evals")
    parser.add_argument("--suite", default="smoke", help="dataset name or 'all'")
    parser.add_argument("--k", type=int, default=1, help="runs per case (3 = consistency)")
    parser.add_argument("--min-pass", type=float, default=1.0, help="minimum pass^k")
    parser.add_argument(
        "--entry",
        default="{{#llm}}{{package}}.app.entrypoint:answer{{/llm}}{{^llm}}{{package}}.pipeline:run{{/llm}}",
    )
    parser.add_argument("--tag", help="only cases with this tag")
    parser.add_argument("--live", action="store_true", help="allow calls to the real model")
    parser.add_argument(
        "--concurrency", type=int, default=1, help="entry calls in flight at once (default 1)"
    )
    args = parser.parse_args(argv)
    if args.concurrency < 1:
        parser.error("--concurrency must be >= 1")

    if args.live:
        os.environ["RUMBO_EVALS_LIVE"] = "1"
    else:
        os.environ.pop("RUMBO_EVALS_LIVE", None)

    cases = load_cases(args.suite)
    if args.tag:
        cases = [c for c in cases if args.tag in c.get("tags", [])]
    if not cases:
        print("No cases to run.")
        return 1
    entry = load_entry(args.entry)

    rows = asyncio.run(run_all(entry, cases, args.k, args.concurrency))
    successes_total = sum(r["ok"] for row in rows for r in row["runs"])

    pass_at_1 = successes_total / (len(cases) * args.k)
    pass_hat_k = sum(r["passes_all"] for r in rows) / len(rows)
    print(
        f"\ncases={len(cases)} k={args.k}  pass@1={pass_at_1:.3f}  pass^{args.k}={pass_hat_k:.3f}"
    )

    current = fingerprint(ROOT, args.entry)
    if args.live:
        record = {**current, "recorded": date.today().isoformat(), "suite": args.suite}
        FINGERPRINT.write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
    else:
        for warning in drift_warnings(current):
            print(warning)

    REPORTS.mkdir(exist_ok=True)
    report = REPORTS / f"{args.suite}-{time.strftime('%Y%m%d-%H%M%S')}.json"
    report.write_text(
        json.dumps(
            {
                "suite": args.suite,
                "k": args.k,
                "live": args.live,
                "concurrency": args.concurrency,
                "fingerprint": current,
                "pass@1": pass_at_1,
                f"pass^{args.k}": pass_hat_k,
                "cases": rows,
            },
            ensure_ascii=False,
            indent=2,
        ),
        encoding="utf-8",
    )
    if pass_hat_k < args.min_pass:
        print(f"FAIL: pass^{args.k}={pass_hat_k:.3f} < threshold {args.min_pass}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

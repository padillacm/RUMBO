"""GenAI telemetry without a dependency: spans as structured JSON log records (phase O).

Attribute names follow the OpenTelemetry GenAI semantic conventions (`gen_ai.operation.name`,
`gen_ai.request.model`, `gen_ai.usage.input_tokens`, ...) plus `cost.usd`, so the records can be
shipped as they are to Langfuse, Phoenix or any OTLP collector. When you reach production,
`uv add opentelemetry-sdk` (verify it first) and attach a real tracer in an adapter: the
call sites in app/ do not change. The weekly trace-review ritual reads these records.

The request id travels in a context variable (ADR-0012): the outermost span of a request sets
it, nested spans and everything awaited inside inherit it, and concurrent requests never see
each other's (asyncio copies the context into every task). Nothing is threaded through
signatures; `current_request_id()` reads it anywhere, e.g. to tag a log line.
"""

from __future__ import annotations

import datetime as dt
import json
import logging
import time
import uuid
from collections.abc import Iterator
from contextlib import contextmanager
from contextvars import ContextVar
from dataclasses import dataclass, field
from typing import Any

from {{package}}.app.budget import Meter

LOGGER_NAME = "{{package}}.telemetry"
log = logging.getLogger(LOGGER_NAME)

REQUEST_ID: ContextVar[str | None] = ContextVar("request_id", default=None)


def current_request_id() -> str | None:
    """The id of the request being served, or None outside any span."""
    return REQUEST_ID.get()


@dataclass
class Span:
    name: str
    attributes: dict[str, Any] = field(default_factory=dict)

    def set(self, **attributes: Any) -> None:
        self.attributes.update(attributes)


def _utc(timestamp: float) -> str:
    return dt.datetime.fromtimestamp(timestamp, dt.UTC).isoformat(timespec="milliseconds")


class JsonFormatter(logging.Formatter):
    """One JSON object per line; `record.span` carries the span attributes."""

    def format(self, record: logging.LogRecord) -> str:
        payload: dict[str, Any] = {
            "ts": _utc(record.created),
            "level": record.levelname,
            "logger": record.name,
            "message": record.getMessage(),
        }
        payload.update(getattr(record, "span", {}))
        return json.dumps(payload, ensure_ascii=False, default=str)


def configure_json_logging(level: int = logging.INFO) -> None:
    """Called at the process boundaries (api/http.py, __main__); idempotent.

    Without it Python drops INFO records and no span is ever emitted.
    """
    root = logging.getLogger()
    if any(isinstance(h.formatter, JsonFormatter) for h in root.handlers):
        return
    handler = logging.StreamHandler()
    handler.setFormatter(JsonFormatter())
    root.addHandler(handler)
    root.setLevel(level)


@contextmanager
def span(
    operation: str,
    *,
    model: str = "",
    request_id: str | None = None,
    meter: Meter | None = None,
    **attributes: Any,
) -> Iterator[Span]:
    """Times a GenAI operation and logs it with OTel attribute names, cost and outcome.

    Synchronous on purpose, so it wraps sync and async code alike. An explicit `request_id`
    becomes the current one for the span's duration; otherwise the span joins the current
    request and, outside any, starts one with a fresh id.
    """
    current = Span(operation, {"gen_ai.operation.name": operation, **attributes})
    token = None
    if request_id or REQUEST_ID.get() is None:
        token = REQUEST_ID.set(request_id or uuid.uuid4().hex)
    current.set(**{"request.id": REQUEST_ID.get()})
    if model:
        current.set(**{"gen_ai.request.model": model})
    start = time.perf_counter()
    try:
        yield current
        current.set(status="ok")
    except Exception as exc:
        current.set(status="error", **{"error.type": type(exc).__name__})
        raise
    finally:
        if meter is not None:
            current.set(**meter.snapshot())
        current.set(**{"duration.ms": round((time.perf_counter() - start) * 1000, 1)})
        level = logging.WARNING if current.attributes.get("status") == "error" else logging.INFO
        log.log(level, operation, extra={"span": current.attributes})
        if token is not None:
            REQUEST_ID.reset(token)

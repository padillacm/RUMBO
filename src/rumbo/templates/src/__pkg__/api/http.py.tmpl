"""HTTP API (FastAPI). Validates at the boundary and delegates to app/."""

from importlib.metadata import version

from fastapi import FastAPI

from {{package}}.app.telemetry import configure_json_logging

configure_json_logging()  # spans and errors as JSON lines; without it INFO records are dropped
__version__ = version("{{package}}")
app = FastAPI(title={{name_py}}, version=__version__)


@app.get("/health")
def health() -> dict[str, str]:
    return {"status": "ok", "version": __version__}

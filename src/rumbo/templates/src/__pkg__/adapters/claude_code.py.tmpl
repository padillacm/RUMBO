"""Model access through the Claude Code CLI (`claude -p`), using the developer's own login.

No API key lives on the machine: the CLI handles authentication. In CI, the nightly job sets
CLAUDE_CODE_OAUTH_TOKEN. Every call is bounded (timeout, max_tokens) and goes through the
offline guard so the check never reaches the network. The CLI runs as an asyncio subprocess
(ADR-0012) with a fixed binary, list arguments and no shell, so awaiting it never blocks the
event loop and several calls can be in flight under `asyncio.gather`.
"""

from __future__ import annotations

import asyncio
import json
import shutil

from {{package}}.app.ports import require_live

DEFAULT_TIMEOUT_S = 120.0


async def complete(
    prompt: str, *, max_tokens: int = 1024, timeout_s: float = DEFAULT_TIMEOUT_S
) -> str:
    """One prompt in, one text out; `timeout_s` is typically `meter.remaining_seconds`."""
    require_live("Claude Code")
    binary = shutil.which("claude")
    if binary is None:
        raise RuntimeError(
            "the `claude` CLI is not installed (npm install -g @anthropic-ai/claude-code)"
        )
    proc = await asyncio.create_subprocess_exec(
        binary,
        "-p",
        prompt,
        "--output-format",
        "json",
        "--max-turns",
        "1",
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE,
    )
    try:
        stdout, stderr = await asyncio.wait_for(proc.communicate(), timeout_s)
    except TimeoutError:
        proc.kill()  # the CLI does not outlive its budget
        await proc.wait()
        raise
    if proc.returncode != 0:
        detail = stderr.decode(errors="replace").strip()[:500]
        raise RuntimeError(f"claude -p failed ({proc.returncode}): {detail}")
    return parse_result(stdout.decode(errors="replace"), max_chars=max_tokens * 4)


def parse_result(stdout: str, *, max_chars: int) -> str:
    """Extracts the text of a `claude -p --output-format json` result, bounded in size."""
    try:
        data = json.loads(stdout)
    except json.JSONDecodeError:
        return stdout.strip()[:max_chars]
    text = data.get("result") if isinstance(data, dict) else None
    if not isinstance(text, str):
        raise RuntimeError("unexpected claude output: no 'result' field")
    return text[:max_chars]

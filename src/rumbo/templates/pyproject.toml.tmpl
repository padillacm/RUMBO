[project]
name = "{{package}}"
version = "0.1.0"
description = {{name_toml}}
readme = "README.md"
requires-python = ">=3.11"
dependencies = []

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{package}}"]

[tool.rumbo]
# RUMBO harness configuration, read by `rumbo gate`, `rumbo doctor` and `rumbo update`.
version = "{{rumbo_version}}"
name = {{name_toml}}
package = "{{package}}"
llm = {{#llm}}true{{/llm}}{{^llm}}false{{/llm}}
provider = "{{provider}}"
sdk_package = "{{sdk_package}}"
sdk_module = "{{sdk_module}}"
sdk_env_key = "{{sdk_env_key}}"
rigor = "{{rigor}}"

[tool.rumbo.checks]
# Verification steps in execution order, read by `scripts/rumbo_check.py` (`rumbo check`).
# One command per step, run without a shell (ADR-0006); `{base}` is origin/main if it exists, else main.
lint = "uv run ruff check ."
format = "uv run ruff format --check ."
types = "uv run pyright"
test = "uv run pytest{{#mvp_or_more}} --cov --cov-report=term-missing:skip-covered{{/mvp_or_more}}"
arch = "uv run lint-imports"
security = "uv run bandit -q -r src{{#llm}} evals{{/llm}}"
security-scripts = "uv run bandit -q -r scripts -s B404,B603,B607"
audit = "uv run pip-audit --skip-editable"
{{#llm}}
# Smoke evals run OFFLINE (recorded fixtures); the model is only called by `make evals-live`.
evals = "uv run python evals/run_evals.py --suite smoke"
{{/llm}}
sensor = "uv run python scripts/check_tests_not_weakened.py --base {base}"

[tool.ruff]
line-length = 100
target-version = "py311"
extend-exclude = ["spikes"]

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "SIM", "S", "RUF"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101", "S603", "S607"]
"evals/**" = ["S101"]
"scripts/**" = ["S603", "S607"]

[tool.pyright]
include = ["src", "tests"]
typeCheckingMode = "standard"
strict = ["src/{{package}}/domain"]
{{#llm}}
extraPaths = ["evals"]
{{/llm}}

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q --strict-markers"

[tool.coverage.run]
source = ["src/{{package}}"]
branch = true

[tool.bandit]
# asserts in evals/ and tests/ are intended (B101); ruff S101 still guards src/.
skips = ["B101"]

[tool.importlinter]
root_package = "{{package}}"
include_external_packages = true

[[tool.importlinter.contracts]]
name = "Hexagonal layers"
type = "layers"
layers = ["{{package}}.api", "{{package}}.adapters", "{{package}}.app", "{{package}}.domain"]

[[tool.importlinter.contracts]]
name = "The domain is pure"
type = "forbidden"
source_modules = ["{{package}}.domain"]
forbidden_modules = [{{forbidden_toml}}]

[tool.mutmut]
# Everything under src/ is copied, only the domain (critical modules) is mutated.
source_paths = ["src/"]
only_mutate = ["src/{{package}}/domain/*"]
also_copy = ["evals/", "scripts/"]

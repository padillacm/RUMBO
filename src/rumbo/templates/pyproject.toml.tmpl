[project]
name = "{{pkg}}"
version = "0.1.0"
description = "{{nombre}}"
readme = "README.md"
requires-python = ">=3.11"
dependencies = []

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{pkg}}"]

[tool.rumbo]
# Configuración del arnés RUMBO (la leen `rumbo gate` y `rumbo doctor`).
version = "{{rumbo_version}}"
pkg = "{{pkg}}"
llm = {{#llm}}true{{/llm}}{{^llm}}false{{/llm}}
proveedor = "{{proveedor}}"
rigor = "{{rigor}}"

[tool.ruff]
line-length = 100
target-version = "py311"
extend-exclude = ["spikes"]

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "SIM", "S", "RUF"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101", "S603", "S607"]
"evals/**" = ["S101"]
"scripts/**" = ["S603", "S607"]

[tool.pyright]
include = ["src", "tests"]
typeCheckingMode = "standard"
strict = ["src/{{pkg}}/domain"]
{{#llm}}
extraPaths = ["evals"]
{{/llm}}

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q --strict-markers"

[tool.coverage.run]
source = ["src/{{pkg}}"]
branch = true

[tool.importlinter]
root_package = "{{pkg}}"
include_external_packages = true

[[tool.importlinter.contracts]]
name = "Capas hexagonales"
type = "layers"
layers = ["{{pkg}}.api", "{{pkg}}.adapters", "{{pkg}}.app", "{{pkg}}.domain"]

[[tool.importlinter.contracts]]
name = "El dominio es puro"
type = "forbidden"
source_modules = ["{{pkg}}.domain"]
forbidden_modules = [{{forbidden_toml}}]

[tool.mutmut]
# Se copia todo src/ pero solo se muta el dominio (módulos críticos).
source_paths = ["src/"]
only_mutate = ["src/{{pkg}}/domain/*"]
also_copy = ["evals/", "scripts/"]

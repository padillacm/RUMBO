[project]
name = "{{package}}"
version = "0.1.0"
description = {{name_toml}}
readme = "README.md"
requires-python = ">={{python}}"
dependencies = []
{{#cli}}

[project.scripts]
{{package}} = "{{package}}.__main__:main"
{{/cli}}

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["{{package_path}}"]

[tool.rumbo]
# RUMBO harness configuration, read by `rumbo gate`, `rumbo doctor` and `rumbo update`.
version = "{{rumbo_version}}"
name = {{name_toml}}
package = "{{package}}"
# ADR-0010: what the project is (service, library, cli, data) and how its package is organised
# (hexagonal, layered, flat). `layers` lists a layered package's layers, outermost first.
kind = "{{kind}}"
layout = "{{layout}}"
{{#layered}}
layers = {{layers_toml_list}}
{{/layered}}
llm = {{#llm}}true{{/llm}}{{^llm}}false{{/llm}}
provider = "{{provider}}"
sdk_package = "{{sdk_package}}"
sdk_module = "{{sdk_module}}"
sdk_env_key = "{{sdk_env_key}}"
rigor = "{{rigor}}"
# ADR-0014: the minimum Python the project promises (requires-python, ruff, CI, Dockerfile,
# .python-version all read it). `rumbo init --python X.Y`; one of the versions rumbo supports.
python = "{{python}}"
# ADR-0015: the type checker (pyright or mypy); it drives the dev tool, the `types` step
# and the [tool.pyright] / [tool.mypy] section below.
types = "{{types}}"
# ADR-0020: the directory that holds the package: "src", or "." when it lives at the
# project root. The paths below (bandit, the type checker, coverage) follow it.
src = "{{src}}"
{{#adopted}}
# ADR-0013: the harness was mounted on an existing project; lint, format and types run on the
# changed files (`{changed}` below), the nightly measures the whole tree with --full.
adopted = true
{{#custom_tests_dir}}
tests = "{{tests_dir}}"
{{/custom_tests_dir}}
{{/adopted}}

[tool.rumbo.checks]
# Verification steps in execution order, read by `scripts/rumbo_check.py` (`rumbo check`).
# One command per step, run without a shell (ADR-0006); `{base}` is origin/main if it exists, else main.
# The steps scale with `rigor` (ADR-0011): `rumbo update` appends the ones your level requires
# (after `rumbo promote` or a hand edit of `rigor`) and never replaces or removes one.
{{#adopted}}
# `{changed}` is the changed .py files (vs {base}, plus uncommitted and untracked ones); `rumbo
# check --full` (or `scripts/rumbo_check.py --full`) replaces it with `.`: the whole tree.
lint = "uv run ruff check {changed}"
format = "uv run ruff format --check {changed}"
types = "uv run {{types}} {changed}"
{{/adopted}}
{{^adopted}}
lint = "uv run ruff check ."
format = "uv run ruff format --check ."
types = "uv run {{types}}"
{{/adopted}}
test = "uv run pytest{{#mvp_or_more}} --cov --cov-report=term-missing:skip-covered{{/mvp_or_more}}"
{{#arch}}
arch = "uv run lint-imports"
{{/arch}}
{{#mvp_or_more}}
security = "uv run bandit -q -r {{code_root}}{{#evals}} evals{{/evals}}"
security-scripts = "uv run bandit -q -r scripts -s B404,B603,B607"
audit = "uv run pip-audit --skip-editable"
{{/mvp_or_more}}
{{#evals}}
# Smoke evals run OFFLINE (recorded fixtures){{#llm}}; the model is only called by `make evals-live`{{/llm}}.
evals = "uv run python evals/run_evals.py --suite smoke"
{{/evals}}
sensor = "uv run python scripts/check_tests_not_weakened.py --base {base}"

[tool.ruff]
line-length = 100
target-version = "py{{python_nodot}}"
extend-exclude = ["spikes"]
# ADR-0020: the exclusions also hold for a file that is named on the command line.
force-exclude = true

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "SIM", "S", "RUF"]

[tool.ruff.lint.per-file-ignores]
"{{tests_dir}}/**" = ["S101", "S603", "S607"]
"evals/**" = ["S101"]
"scripts/**" = ["S603", "S607"]

{{#pyright}}
[tool.pyright]
include = ["{{code_root}}", "{{tests_dir}}"]
typeCheckingMode = "standard"
{{#arch}}
strict = ["{{package_path}}/{{inner_layer}}"]
{{/arch}}
{{#evals}}
extraPaths = ["evals"]
{{/evals}}
{{/pyright}}
{{#mypy}}
[tool.mypy]
# ADR-0015: the same contract as [tool.pyright]: {{code_root}} and {{tests_dir}} checked{{#arch}}, the
# {{inner_layer}} layer strict{{/arch}}.
files = ["{{code_root}}", "{{tests_dir}}"]
python_version = "{{python}}"
check_untyped_defs = true
warn_unused_ignores = true
warn_redundant_casts = true
no_implicit_optional = true
{{#evals}}
mypy_path = "evals"
{{/evals}}
{{#arch}}

[[tool.mypy.overrides]]
# The {{inner_layer}} layer is strict. mypy applies `strict = true` globally even inside an
# override, so the flags of --strict that work per module are listed one by one.
module = "{{package}}.{{inner_layer}}.*"
disallow_any_generics = true
disallow_subclassing_any = true
disallow_untyped_calls = true
disallow_untyped_defs = true
disallow_incomplete_defs = true
disallow_untyped_decorators = true
warn_return_any = true
no_implicit_reexport = true
strict_equality = true
extra_checks = true
{{/arch}}
{{/mypy}}

[tool.pytest.ini_options]
testpaths = ["{{tests_dir}}"]
addopts = "-q --strict-markers"

[tool.coverage.run]
source = ["{{package_path}}"]
branch = true
{{#arch}}

[tool.importlinter]
root_package = "{{package}}"
include_external_packages = true

[[tool.importlinter.contracts]]
name = "Layers ({{layout}}, outermost first)"
type = "layers"
layers = [{{layers_toml}}]

[[tool.importlinter.contracts]]
name = "The {{inner_layer}} layer is pure"
type = "forbidden"
source_modules = ["{{package}}.{{inner_layer}}"]
forbidden_modules = [{{forbidden_toml}}]

[tool.mutmut]
# Everything under {{code_root}}/ is copied, only the {{inner_layer}} layer (critical modules) is mutated.
source_paths = ["{{code_root}}/"]
only_mutate = ["{{package_path}}/{{inner_layer}}/*"]
also_copy = [{{#evals}}"evals/", {{/evals}}"scripts/"]
{{/arch}}

[tool.bandit]
# asserts in evals/ and tests/ are intended (B101); ruff S101 still guards {{code_root}}/.
skips = ["B101"]

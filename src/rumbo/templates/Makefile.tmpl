# RUMBO Makefile — optional aliases for the verification runner (ADR-0006):
#   uv run python scripts/rumbo_check.py [STEP ...]   (steps: [tool.rumbo.checks] in pyproject.toml)
# One-line recipes (`target: ; command`) so tabs never bite.
# Kind: {{kind}} · Layout: {{layout}} · Rigor: {{rigor}}{{#llm}} · LLM provider: {{provider}}{{/llm}}

.PHONY: check check-brief test lint types arch security evals evals-live mutation sensor sbom hooks fmt review rumbo

# A locally installed `rumbo` is used when present; otherwise uvx fetches it (needs network).
RUMBO ?= $(shell command -v rumbo >/dev/null 2>&1 && echo rumbo || echo "uvx rumbo")
# Base for the review: origin/main when it exists, else main.
BASE ?= $(shell git rev-parse --verify -q origin/main >/dev/null 2>&1 && echo origin/main || echo main)

check:       ; uv run python scripts/rumbo_check.py
# Agent-friendly: only the failing tail reaches the context; the full log stays in .rumbo-check.log.
check-brief: ; uv run python scripts/rumbo_check.py --brief
lint:        ; uv run python scripts/rumbo_check.py lint format
fmt:         ; uv run ruff check --fix . && uv run ruff format .
types:       ; uv run python scripts/rumbo_check.py types
test:        ; uv run python scripts/rumbo_check.py test
{{#arch}}
arch:        ; uv run python scripts/rumbo_check.py arch
{{/arch}}
security:    ; uv run python scripts/rumbo_check.py security security-scripts audit
sensor:      ; uv run python scripts/rumbo_check.py sensor
{{#evals}}
# Smoke evals run OFFLINE (recorded fixtures){{#llm}}; the model is only called with `make evals-live`{{/llm}}.
evals:       ; uv run python scripts/rumbo_check.py evals
{{/evals}}
{{#llm}}
evals-live:  ; uv run python evals/run_evals.py --suite all --live --k {{#production}}3{{/production}}{{^production}}1{{/production}}
{{/llm}}
{{#arch}}
# POSIX only: mutmut needs os.fork, so this stays out of the runner (nightly runs it on Linux).
mutation:    ; @if find {{package_path}}/{{inner_layer}} -name '*.py' ! -name '__init__.py' | grep -q .; then uv run mutmut run && uv run mutmut results; else echo '{{inner_layer}}/ is still empty: nothing to mutate'; fi
{{/arch}}
sbom:        ; uv export --no-dev --no-emit-project --format cyclonedx1.5 -o sbom.cdx.json
hooks:       ; uv run pre-commit install
review:      ; $(RUMBO) tour $(BASE) --out docs/reviews/
rumbo:       ; $(RUMBO) $(ARGS)

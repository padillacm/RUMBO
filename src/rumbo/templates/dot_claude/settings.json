{
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make check-brief)",
      "Bash(make fmt)",
      "Bash(make lint)",
      "Bash(make types)",
      "Bash(make test)",
      "Bash(make arch)",
      "Bash(make sensor)",
      "Bash(make review)",
      "Bash(make rumbo *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright *)",
      "Bash(uv run lint-imports)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/*.pem)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python scripts/rumbo_guard.py pre-tool",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python scripts/rumbo_guard.py stop",
            "timeout": 900
          }
        ]
      }
    ]
  }
}

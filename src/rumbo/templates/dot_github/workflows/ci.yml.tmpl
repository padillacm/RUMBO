# RUMBO CI (RUMBO.md, Part A, step A5): the sensors run on every push and pull request.
# - `scripts/rumbo_check.py` (ADR-0006) is OFFLINE: no model credentials here, so a PR can never
#   exfiltrate them. It needs no shell, so the same job runs on Linux and on Windows.
# - Actions are pinned by SHA (supply chain); Dependabot keeps them fresh.
name: ci

on:
  push:
  pull_request:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: ubuntu-latest
{{#packaged}}
    # ADR-0010: a package others install runs on every Python it promises (requires-python).
    strategy:
      fail-fast: false
      matrix:
        python: ["3.11", "3.12", "3.13"]
    env:
      UV_PYTHON: ${{ matrix.python }}
{{/packaged}}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
      - name: Install dependencies (lockfile)
        run: uv sync --locked
      - name: rumbo check
        run: uv run python scripts/rumbo_check.py
      - name: Anti-cheat sensor (tests not weakened)
        env:
          RUMBO_BASE_REF: ${{ github.event.pull_request.base.sha || github.event.before }}
        run: uv run python scripts/check_tests_not_weakened.py --strict
{{#mvp_or_more}}
      - name: Hygiene (pre-commit, all files)
        run: uv run pre-commit run --all-files --show-diff-on-failure
{{/mvp_or_more}}
{{#production}}
      - name: SBOM (CycloneDX, runtime dependencies from uv.lock)
        run: uv export --no-dev --no-emit-project --format cyclonedx1.5 -o sbom.cdx.json
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: sbom
          path: sbom.cdx.json
{{/production}}

  check-windows:
    # The same runner on Windows: the harness depends on neither a build tool nor a POSIX shell.
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
      - name: Install dependencies (lockfile)
        run: uv sync --locked
      - name: rumbo check
        run: uv run python scripts/rumbo_check.py

  secrets:
    # Full-history secret scan. The pre-commit hook only sees staged files, so this job is
    # the sensor that actually protects the repository.
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: gitleaks/gitleaks-action@e0c47f4f8be36e29cdc102c57e68cb5cbf0e8d1e # v3.0.0
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

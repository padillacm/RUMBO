# Nightly RUMBO (A5): mutation testing sobre domain/{{#llm}} y suite completa de evals{{/llm}}.
name: nightly

on:
  schedule:
    - cron: "17 6 * * *"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  mutation:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
      - run: uv sync --locked
      - name: mutmut sobre src/{{pkg}}/domain
        run: make mutation
{{#llm}}

  evals:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
      - run: uv sync --locked
      - name: Suite completa de evals
        run: make evals-full
        env:
          {{sdk_env_key}}: ${{ secrets.{{sdk_env_key}} }}
{{/llm}}

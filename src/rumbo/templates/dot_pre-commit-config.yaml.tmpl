# RUMBO hooks: the same sensors for the human and the agent.
# `rumbo init` runs `pre-commit autoupdate` so the revs below are refreshed on install.
# Note: the gitleaks hook scans STAGED changes only; CI runs a full gitleaks scan.
# ADR-0008: `pre-commit install` wires both git hooks; the hooks below run at pre-commit unless
# they say otherwise, so the commit message is never handed to a file fixer.
default_install_hook_types: [pre-commit, commit-msg]
default_stages: [pre-commit]
repos:
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.17.3
    hooks:
      - id: ruff-check
      - id: ruff-format
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.30.1
    hooks:
      - id: gitleaks
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: check-added-large-files
      - id: end-of-file-fixer
      - id: trailing-whitespace
      - id: check-yaml
      - id: check-toml
      - id: check-merge-conflict
      - id: detect-private-key
  - repo: https://github.com/astral-sh/uv-pre-commit
    rev: 0.13.6
    hooks:
      - id: uv-lock
  - repo: local
    hooks:
{{#arch}}
      - id: lint-imports
        name: lint-imports (architecture contracts)
        entry: uv run lint-imports
        language: system
        pass_filenames: false
        types: [python]
{{/arch}}
      # ADR-0008: the guard binds any coding agent at commit time (AGENTS.md hard rules).
      # The actor is read from the environment and `git config rumbo.human`; the human passes.
      - id: rumbo-guard
        name: rumbo-guard (protected files, template mark)
        entry: uv run python scripts/rumbo_guard.py pre-commit
        language: system
        always_run: true
        pass_filenames: false
        stages: [pre-commit]
      - id: rumbo-guard-commit-msg
        name: rumbo-guard (approval mark)
        entry: uv run python scripts/rumbo_guard.py commit-msg
        language: system
        stages: [commit-msg]
